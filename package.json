{
  "name": "steadyui",
  "version": "0.1.0",
  "description": "A small accessible React component library and checkout demo, built to be tested rather than assumed.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:a11y:pages": "node scripts/axe-pages.mjs",
    "pretest": "npm run tokens",
    "test:keyboard": "node scripts/keyboard-checks.mjs",
    "test:report": "node scripts/build-test-report.mjs",
    "build:site": "npm run tokens && storybook build -o site --quiet && vite build --base ./ --outDir site/checkout --emptyOutDir false"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "playwright": "1.63.0",
    "storybook": "^10.6.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
