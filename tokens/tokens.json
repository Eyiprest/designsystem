{
  "$description": "Steady design tokens. Source of truth for CSS custom properties and Figma Variables. Edit here, then run `npm run tokens`.",
  "color": {
    "bg": {
      "canvas":  { "$value": "#FBFAF7", "$description": "Page background" },
      "surface": { "$value": "#FFFFFF", "$description": "Inputs, dialogs, table body" },
      "subtle":  { "$value": "#F1EFE8", "$description": "Table header, hover rows, code" },
      "inverse": { "$value": "#1D1C19", "$description": "Toast background" }
    },
    "text": {
      "primary":   { "$value": "#1D1C19" },
      "secondary": { "$value": "#57544C" },
      "on-primary": { "$value": "#FFFFFF" },
      "on-inverse": { "$value": "#FBFAF7" },
      "disabled":  { "$value": "#7B776C", "$description": "Inactive component text. Exempt from WCAG 1.4.3, documented anyway." }
    },
    "border": {
      "default": { "$value": "#7D796D", "$description": "Control boundaries. Must reach 3:1 (WCAG 1.4.11)." },
      "subtle":  { "$value": "#DAD6CB", "$description": "Dividers only. Never the sole boundary of a control." },
      "disabled": { "$value": "#C4C0B4" }
    },
    "primary": {
      "default": { "$value": "#0B6B70" },
      "hover":   { "$value": "#08555A" },
      "active":  { "$value": "#064044" },
      "subtle":  { "$value": "#E1F0F0" }
    },
    "focus": {
      "inner": { "$value": "#FFFFFF", "$description": "Gap colour between element and ring" },
      "outer": { "$value": "#1D1C19", "$description": "Visible ring" }
    },
    "disabled": {
      "bg": { "$value": "#EEECE6" }
    },
    "error": {
      "default": { "$value": "#B3261E", "$description": "Text, borders and icons on canvas or surface" },
      "subtle":  { "$value": "#FCE9E7" }
    },
    "success": {
      "default": { "$value": "#1E6B34" },
      "subtle":  { "$value": "#E5F2E8" }
    },
    "warning": {
      "default": { "$value": "#7A4800" },
      "subtle":  { "$value": "#FFF1CF" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "'Atkinson Hyperlegible Next Variable', 'Atkinson Hyperlegible Next', system-ui, sans-serif" },
      "mono": { "$value": "'Atkinson Hyperlegible Mono', ui-monospace, monospace" }
    },
    "size": {
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" }
    },
    "weight": {
      "regular": { "$value": "400" },
      "medium":  { "$value": "500" },
      "bold":    { "$value": "700" }
    },
    "line-height": {
      "tight":  { "$value": "1.25" },
      "normal": { "$value": "1.5" }
    }
  },
  "space": {
    "0":  { "$value": "0px" },
    "1":  { "$value": "2px" },
    "2":  { "$value": "4px" },
    "3":  { "$value": "8px" },
    "4":  { "$value": "12px" },
    "5":  { "$value": "16px" },
    "6":  { "$value": "24px" },
    "7":  { "$value": "32px" },
    "8":  { "$value": "48px" },
    "9":  { "$value": "64px" }
  },
  "radius": {
    "none": { "$value": "0px" },
    "sm":   { "$value": "2px", "$description": "Checkbox, table cells" },
    "md":   { "$value": "4px", "$description": "Buttons, inputs, selects, tabs" },
    "lg":   { "$value": "8px", "$description": "Dialog, toast" },
    "full": { "$value": "9999px", "$description": "Switch track and thumb, radio" }
  },
  "border": {
    "width": {
      "default":  { "$value": "1px" },
      "emphasis": { "$value": "2px" }
    }
  },
  "focus": {
    "width":  { "$value": "2px" },
    "offset": { "$value": "2px" }
  },
  "size": {
    "control-sm": { "$value": "32px" },
    "control-md": { "$value": "40px" },
    "control-lg": { "$value": "48px" },
    "target-min": { "$value": "24px", "$description": "WCAG 2.5.8 floor. No interactive target goes below this." },
    "icon":       { "$value": "20px" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" }
    }
  },
  "contrast": {
    "$description": "Pairs that must pass. Format: foreground, background, minimum ratio, WCAG criterion, where used.",
    "pairs": [
      ["color.text.primary",    "color.bg.canvas",     4.5, "1.4.3",  "Body text on page"],
      ["color.text.primary",    "color.bg.surface",    4.5, "1.4.3",  "Text in inputs, dialogs"],
      ["color.text.primary",    "color.bg.subtle",     4.5, "1.4.3",  "Table header, hover row"],
      ["color.text.secondary",  "color.bg.canvas",     4.5, "1.4.3",  "Hint text on page"],
      ["color.text.secondary",  "color.bg.surface",    4.5, "1.4.3",  "Hint text in surface"],
      ["color.text.secondary",  "color.bg.subtle",     4.5, "1.4.3",  "Secondary text on subtle"],
      ["color.text.on-primary", "color.primary.default", 4.5, "1.4.3", "Primary button label"],
      ["color.text.on-primary", "color.primary.hover",   4.5, "1.4.3", "Primary button label, hover"],
      ["color.text.on-primary", "color.primary.active",  4.5, "1.4.3", "Primary button label, pressed"],
      ["color.primary.default", "color.bg.canvas",     4.5, "1.4.3",  "Link text, secondary button label"],
      ["color.primary.default", "color.bg.surface",    4.5, "1.4.3",  "Link text in surface"],
      ["color.primary.active",  "color.primary.subtle", 4.5, "1.4.3", "Selected tab or nav label on subtle"],
      ["color.text.primary",    "color.primary.subtle", 4.5, "1.4.3", "Text on selected row"],
      ["color.text.on-inverse", "color.bg.inverse",    4.5, "1.4.3",  "Toast text"],
      ["color.error.default",   "color.bg.canvas",     4.5, "1.4.3",  "Error text on page"],
      ["color.error.default",   "color.bg.surface",    4.5, "1.4.3",  "Error text in surface"],
      ["color.error.default",   "color.error.subtle",  4.5, "1.4.3",  "Error summary text"],
      ["color.success.default", "color.bg.surface",    4.5, "1.4.3",  "Success text"],
      ["color.success.default", "color.success.subtle", 4.5, "1.4.3", "Success alert text"],
      ["color.warning.default", "color.bg.surface",    4.5, "1.4.3",  "Warning text"],
      ["color.warning.default", "color.warning.subtle", 4.5, "1.4.3",  "Warning alert text"],
      ["color.border.default",  "color.bg.canvas",     3,   "1.4.11", "Input, select, checkbox border on page"],
      ["color.border.default",  "color.bg.surface",    3,   "1.4.11", "Input border on surface"],
      ["color.primary.default", "color.bg.canvas",     3,   "1.4.11", "Selected checkbox, switch on, radio dot"],
      ["color.primary.default", "color.bg.surface",    3,   "1.4.11", "Selected control on surface"],
      ["color.error.default",   "color.bg.surface",    3,   "1.4.11", "Error border"],
      ["color.focus.outer",     "color.bg.canvas",     3,   "1.4.11", "Focus ring on page"],
      ["color.focus.outer",     "color.bg.surface",    3,   "1.4.11", "Focus ring on surface"],
      ["color.focus.outer",     "color.focus.inner",   3,   "1.4.11", "Focus ring against its own gap"]
    ]
  }
}
